# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- LLM (Groq) --- get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Check these still exist with:  cd services/orchestrator-api && uv run python -m app.llm
GROQ_STRONG_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# --- Postgres (started by docker-compose) ---
POSTGRES_USER=ops_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=ops_platform
POSTGRES_PORT=5432
READONLY_DB_PASSWORD=change-me-readonly

# Admin connection: used ONLY by the seed script / schema changes.
DATABASE_URL=postgresql://ops_admin:change-me-admin@localhost:5432/ops_platform
# Read-only connection: the ONLY connection the DB agent is allowed to use.
READONLY_DATABASE_URL=postgresql://readonly_agent:change-me-readonly@localhost:5432/ops_platform

# --- Mailpit (fake SMTP inbox for development) ---
SMTP_HOST=localhost
SMTP_PORT=1025
