# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- LLM (Groq) --- get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Check these still exist with:  cd services/orchestrator-api && uv run python -m app.llm
GROQ_STRONG_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# --- Postgres (started by docker-compose) ---
POSTGRES_USER=ops_admin
POSTGRES_PASSWORD=admin@123
POSTGRES_DB=ops_platform
POSTGRES_PORT=5432
READONLY_DB_PASSWORD=change-me-readonly

# Admin connection: used ONLY by the seed script / schema changes.
# Special characters in a password must be URL-encoded inside a URL: "@" -> "%40" (admin@123 -> admin%40123).
DATABASE_URL=postgresql://ops_admin:admin%40123@localhost:5432/ops_platform
# Read-only connection: the ONLY connection the DB agent is allowed to use.
READONLY_DATABASE_URL=postgresql://readonly_agent:change-me-readonly@localhost:5432/ops_platform
# App connection: chat sessions/messages in schema `app` (role app_rw). Never sees business tables.
APP_DB_PASSWORD=change-me-app
APP_DATABASE_URL=postgresql://app_rw:change-me-app@localhost:5432/ops_platform

# --- Chat memory ---
# How many previous question/answer exchanges of the SAME chat the agent sees.
CHAT_MEMORY_TURNS=3

# --- Document Q&A (RAG agent, plannings/02-doc-qa-rag-agent.md) ---
# Uploaded files and picture crops (relative paths are relative to the repo root). Git-ignored.
DATA_DIR=./data
# Describes charts/diagrams inside documents (must support image input).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# 384-dimension embeddings. Changing it = re-embedding every document.
RAG_EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2
RAG_RERANK=true
RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_TOKENS=350
RAG_CANDIDATES=20
RAG_TOP_K=6
RAG_CONTEXT_TOKENS=3000
# Empty = no threshold; set it from the RAG eval's score distribution. R9 (2026-11-22): leave it empty, the answerable
# and not-in-document scores overlap (evals/reports/rag-retrieval-2026-11-22.md); the answer model decides instead.
RAG_MIN_RERANK_SCORE=
RAG_MAX_FILE_MB=25
RAG_MAX_PAGES=150
RAG_MAX_PICTURES_PER_DOC=20
RAG_MIN_PICTURE_AREA=0.02

# --- Orchestrator (ReAct supervisor, plannings/03-orchestrator.md) ---
# Decides which agent to call. Must support tool calling on Groq (gpt-oss-120b behaved the same in tests).
GROQ_ORCHESTRATOR_MODEL=openai/gpt-oss-20b
# Limits per question, enforced in code (plan 03 section 6).
ORCH_MAX_TOOL_CALLS=4
# Per ask_database / ask_documents / search_web. draft_email is always max 1 (not configurable).
ORCH_MAX_CALLS_PER_TOOL=2
ORCH_MAX_SUPERVISOR_CALLS=6
ORCH_TURN_TIMEOUT_SECONDS=120
ORCH_TOOL_TIMEOUT_SECONDS=60
ORCH_TOOL_RESULT_CHARS=2000
# One recipient per email (plan 04, decision 6); a request for more is refused by the S12 check.
ORCH_MAX_EMAIL_RECIPIENTS=1
ORCH_SUPERVISOR_MAX_TOKENS=1200

# --- Input guardrail (NeMo Guardrails, plannings/04) ---
# Checks every chat message before the orchestrator sees it. false only for local experiments (logged loudly).
GUARD_ENABLED=true
# Rail 1: jailbreak / instruction-override attacks (returns a probability).
GUARD_JAILBREAK_MODEL=meta-llama/llama-prompt-guard-2-86m
GUARD_JAILBREAK_THRESHOLD=0.5
# Rail 2: harmful or illegal requests. openai/gpt-oss-safeguard-20b is better but allows only 3 requests/min on the free tier.
GUARD_SAFETY_MODEL=allam-2-7b
# A guard call that times out or fails BLOCKS the message (fail closed).
GUARD_TIMEOUT_SECONDS=10

# --- Web search (DuckDuckGo MCP server, plannings/04) ---
# Pinned; started with `uvx --from <package>` in its own environment (never add it to pyproject.toml).
WEB_MCP_PACKAGE=duckduckgo-mcp-server==0.7.0
WEB_SAFE_SEARCH=STRICT
WEB_REGION=wt-wt
WEB_MAX_RESULTS=6
WEB_SEARCH_RPM=20
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SNIPPET_CHARS=400

# --- Request rate limits per client (questions = chat messages, email decisions, /api/db/ask; 0 = rule off) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUESTIONS_PER_MINUTE=6
RATE_LIMIT_QUESTIONS_PER_DAY=150
RATE_LIMIT_UPLOADS_PER_HOUR=20

# --- Email agent (plan 05): the email service (services/email-a2a-service, port 8001), reached over A2A ---
# SMTP settings live in that service's own .env (services/email-a2a-service/.env.example), not here.
# EMAIL_DB_PASSWORD: the database init script creates role email_rw with it (schema `email`, the A2A tasks).
EMAIL_DB_PASSWORD=change-me-email
EMAIL_AGENT_URL=http://localhost:8001
# The SAME value as EMAIL_SERVICE_API_KEY in the email service's .env.
EMAIL_AGENT_API_KEY=CHANGEME
EMAIL_DRAFT_TIMEOUT_SECONDS=120
EMAIL_DECISION_TIMEOUT_SECONDS=45

# --- Langfuse (self-hosted tracing, docker-compose.langfuse.yml) ---
# Start it with:  docker compose -f docker-compose.langfuse.yml up -d   ->  UI at http://localhost:3000
# The API sends traces only when LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY are set (empty = tracing off).
# The keys below are created in Langfuse at its first start (headless init), so the app can use them right away.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
# The Langfuse admin login (created at the first start).
LANGFUSE_INIT_USER_EMAIL=admin@ops.example
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
# Langfuse server secrets: generate each with  openssl rand -hex 32
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME_64_hex_chars
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_DB_PASSWORD=CHANGEME
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGEME
LANGFUSE_REDIS_AUTH=CHANGEME
LANGFUSE_MINIO_PASSWORD=CHANGEME

# --- Docker (docker compose --profile app up -d --build) ---
# The API container runs as you, so files it writes into ./data stay yours: `id -u` and `id -g`.
HOST_UID=1000
HOST_GID=1000
# The email service in Docker sends to the Mailpit container; set this to send through a real mailbox instead
# (port, TLS and login come from services/email-a2a-service/.env).
# EMAIL_DOCKER_SMTP_HOST=smtp.gmail.com
