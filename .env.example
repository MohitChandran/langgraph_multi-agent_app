# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# --- LLM (Groq) --- get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Check these still exist with:  cd services/orchestrator-api && uv run python -m app.llm
GROQ_STRONG_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# --- Postgres (started by docker-compose) ---
POSTGRES_USER=ops_admin
POSTGRES_PASSWORD=admin@123
POSTGRES_DB=ops_platform
POSTGRES_PORT=5432
READONLY_DB_PASSWORD=change-me-readonly

# Admin connection: used ONLY by the seed script / schema changes.
# Special characters in a password must be URL-encoded inside a URL: "@" -> "%40" (admin@123 -> admin%40123).
DATABASE_URL=postgresql://ops_admin:admin%40123@localhost:5432/ops_platform
# Read-only connection: the ONLY connection the DB agent is allowed to use.
READONLY_DATABASE_URL=postgresql://readonly_agent:change-me-readonly@localhost:5432/ops_platform
# App connection: chat sessions/messages in schema `app` (role app_rw). Never sees business tables.
APP_DB_PASSWORD=change-me-app
APP_DATABASE_URL=postgresql://app_rw:change-me-app@localhost:5432/ops_platform

# --- Chat memory ---
# How many previous question/answer exchanges of the SAME chat the agent sees.
CHAT_MEMORY_TURNS=3

# --- Document Q&A (RAG agent, plannings/02-doc-qa-rag-agent.md) ---
# Uploaded files and picture crops (relative paths are relative to the repo root). Git-ignored.
DATA_DIR=./data
# Describes charts/diagrams inside documents (must support image input).
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# 384-dimension embeddings. Changing it = re-embedding every document.
RAG_EMBEDDING_MODEL=ibm-granite/granite-embedding-small-english-r2
RAG_RERANK=true
RAG_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_CHUNK_TOKENS=350
RAG_CANDIDATES=20
RAG_TOP_K=6
RAG_CONTEXT_TOKENS=3000
# Empty = no threshold; set it from the RAG eval's score distribution.
RAG_MIN_RERANK_SCORE=
RAG_MAX_FILE_MB=25
RAG_MAX_PAGES=150
RAG_MAX_PICTURES_PER_DOC=20
RAG_MIN_PICTURE_AREA=0.02

# --- Mailpit (fake SMTP inbox for development) ---
SMTP_HOST=localhost
SMTP_PORT=1025
