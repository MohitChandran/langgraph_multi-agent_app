# Email service settings (plan 05, section 7). Copy to .env in THIS folder and fill in the CHANGEME values.
# This service has its own .env: its secrets (SMTP password, API key) are never in the orchestrator's environment.

# --- A2A server ---
# The orchestrator must send this in the X-API-Key header. Put the SAME value in the repo-root .env as
# EMAIL_AGENT_API_KEY. Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_SERVICE_API_KEY=CHANGEME
EMAIL_SERVICE_PUBLIC_URL=http://localhost:8001

# --- Storage: A2A tasks (drafts waiting for approval) in Postgres schema `email`, role email_rw ---
# The password is EMAIL_DB_PASSWORD from the repo-root .env (the database init script creates the role with it).
EMAIL_DATABASE_URL=postgresql+asyncpg://email_rw:CHANGEME@localhost:5432/ops_platform

# --- The CrewAI crew on Groq (qwen3.8-27b has its own quota, separate from the orchestrator's gpt-oss-20b) ---
GROQ_API_KEY=CHANGEME
EMAIL_CREW_MODEL=qwen/qwen3.8-27b
EMAIL_CREW_CONTEXT_WINDOW=8192
EMAIL_CREW_TIMEOUT_SECONDS=90

# --- Who may receive email ---
# The From address. With a real mailbox (Gmail etc.) it must be that mailbox's own address.
EMAIL_FROM=ops-assistant@company.example
# Comma-separated domains ("company.example": anyone there) or exact addresses ("me@gmail.com": only that one).
EMAIL_ALLOWED_DOMAINS=company.example,example.com
# true = any recipient. Keep false unless you really mean it.
EMAIL_ALLOW_ANY_DOMAIN=false

# --- SMTP ---
# Development: Mailpit (docker compose) catches every email: http://localhost:8025. No login, no TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
# A real mailbox, e.g. Gmail (needs 2-Step Verification + an App Password, NOT your normal password):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS=true  SMTP_USERNAME=<you>@gmail.com
#   SMTP_PASSWORD=<16-character app password>  EMAIL_FROM=<you>@gmail.com  EMAIL_ALLOWED_DOMAINS=<allowed addresses>

# --- Tracing (Langfuse): the SAME keys as LANGFUSE_* in the repo-root .env, so the email service's spans join the
# orchestrator's trace. Empty = tracing off. (CrewAI's own telemetry is switched off in code: app/__init__.py.)
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
